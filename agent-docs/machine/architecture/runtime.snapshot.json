        "type": "daemon_worker",
        "paths": [
          "src/fls_pilot/runtime/audio_worker.py",
          "src/fls_pilot/analysis/audio_features.py"
        ],
        "responsibility": "Runs deterministic cancellable offline feature extraction through daemon-owned durable Runtime jobs."
      },
