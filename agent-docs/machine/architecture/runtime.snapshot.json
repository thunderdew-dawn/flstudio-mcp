  "payload": {
    "communication_protocol": {
      "primary": "MIDI SysEx JSON bridge",
      "why": "FL controller scripts are sandboxed; always-on controller script cannot use files/network/subprocess, so virtual MIDI is the trusted boundary.",
      "ports": {
        "server_to_fl": "FLStudioPilot RX",
        "fl_to_server": "FLStudioPilot TX",
        "routing": "both FL MIDI devices must share the same FL port number, docs use 42"
      },
      "sysex_body": {
        "manufacturer_id": "0x7D private use",
        "magic": "MCP",
        "direction_values": {
          "0x01": "request",
          "0x02": "response",
          "0x03": "heartbeat"
        },
        "request_id": "8 ASCII [a-z0-9]",
        "payload": "base64 encoded UTF-8 JSON"
      },
      "protocol_version": 3,
      "heartbeat_seconds": 0.5,
      "stale_threshold_seconds": 3.0,
      "safe_payload_strategy": "host rejects requests and controller replaces responses above 1000 final wire bytes; expensive step, peak, plugin, and list operations use bounded pages or grouped writes"
    },
