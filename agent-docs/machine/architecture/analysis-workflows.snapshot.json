          "responsibility": "Local HTTP UI for setup checks, daemon/SSE lifecycle, reports, workflow panels."
        },
        {
          "id": "analysis_runtime",
          "label": "Analysis Runtime",
          "type": "module_cluster",
          "paths": [
            "src/fls_pilot/analysis/*.py",
            "src/fls_pilot/workflows/*.py",
            "src/fls_pilot/workflow_report.py"
          ],
          "responsibility": "Static/live evidence broker, observation store, report schema, scoring, health aggregation, workflow registry."
        },
        {
          "id": "knowledgebase",
