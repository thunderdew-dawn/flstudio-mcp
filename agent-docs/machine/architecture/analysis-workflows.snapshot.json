    "analysis_architecture": {
      "nodes": [
        {
          "id": "ai_clients",
          "label": "MCP/AI Clients",
          "type": "external",
          "paths": [
            "Claude Desktop",
            "ChatGPT Desktop/SSE",
            "Cursor",
            "other MCP hosts"
          ],
          "responsibility": "User-facing AI host calls MCP tools/resources/prompts."
        },
        {
          "id": "mcp_server",
          "label": "FastMCP Server",
          "type": "process",
          "paths": [
            "src/fls_pilot/server.py"
          ],
          "responsibility": "Registers tool modules, resources and prompts; exposes stdio or SSE MCP transports."
        },
        {
          "id": "tool_surface",
          "label": "MCP Tool Surface",
          "type": "module_cluster",
          "paths": [
            "src/fls_pilot/tools/*.py"
          ],
          "responsibility": "Domain tools for transport, mixer, channel, pattern, playlist, effects, plugins, routing, mix review, project health, KB, audio, MIDI export."
        },
        {
          "id": "operation_registry",
          "label": "Operation Registry",
          "type": "module",
          "paths": [
            "src/fls_pilot/operations.py"
          ],
          "responsibility": "Declarative safety classes, validation, command mapping, snapshots/readback/restore builders."
        },
        {
          "id": "safety_layer",
          "label": "Safety & Rollback Layer",
          "type": "module",
          "paths": [
            "src/fls_pilot/safety.py"
          ],
          "responsibility": "Persistent-write contract: scoped snapshot, dry-run, readback verification, changelog, rollback units."
        },
        {
          "id": "bridge",
          "label": "Bridge Client",
          "type": "module",
          "paths": [
            "src/fls_pilot/connection.py",
            "src/fls_pilot/protocol.py"
          ],
          "responsibility": "MIDI SysEx or TCP bridge, request correlation, heartbeat tracking, pagination/retry."
        },
        {
          "id": "daemon",
          "label": "TCP Daemon + Runtime Host",
          "type": "process",
          "paths": [
            "src/fls_pilot/daemon.py",
            "src/fls_pilot/runtime/*.py"
          ],
          "responsibility": "Long-lived local RPC service with canonical Runtime state, durable jobs, audio worker execution, snapshots, reports, and workflow execution."
        },
        {
          "id": "control_center",
          "label": "Control Center",
          "type": "process/ui",
          "paths": [
            "src/fls_pilot/control_center.py",
            "src/fls_pilot/control_center_static/*"
          ],
          "responsibility": "Local HTTP UI for setup, Runtime workflows, durable audio jobs, reports, and evidence linking."
        },
        {
          "id": "analysis_runtime",
          "label": "Analysis Runtime",
          "type": "module_cluster",
          "paths": [
            "src/fls_pilot/analysis/*.py",
            "src/fls_pilot/workflows/*.py",
            "src/fls_pilot/workflow_report.py"
          ],
          "responsibility": "Canonical strict AnalysisReport v1, observations, rendered-audio evidence, freshness, scoring, health aggregation, and workflow declarations."
        },
        {
          "id": "knowledgebase",
          "label": "Knowledgebase",
          "type": "data",
          "paths": [
            "knowledgebase/**/*.md",
            "knowledgebase/**/*.json",
            "src/fls_pilot/kb_policy.py"
          ],
          "responsibility": "Calibration, FL API limits, safety policies, recipes, templates and workflow guidance."
        },
        {
          "id": "music_logic",
          "label": "Music Logic",
          "type": "module_cluster",
          "paths": [
            "src/fls_pilot/music/*.py",
