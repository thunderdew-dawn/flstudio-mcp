            "patterns",
            "playlist",
            "plugins",
            "transport",
            "general",
            "device",
            "ui"
          ],
          "responsibility": "Host DAW scripting APIs. Sandbox limitations define supported capabilities."
        },
        {
          "id": "audio_worker",
